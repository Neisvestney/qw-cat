  <releases>
    <release version="1.0.0~rc.3" date="2026-10-10" type="development">
      <url>https://github.com/Neisvestney/qw-cat/releases/tag/v1.0.0-rc.3</url>

      <description>
        <ul>
          <li>Improve release build caching and roll back incomplete releases on failure</li>
